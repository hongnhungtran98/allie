{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22.12.0",
    "pnpm": "10"
  },
  "deploy": {
    "aptPackages": [
      "chromium",
      "fonts-liberation",
      "libnss3",
      "libatk1.0-0",
      "libatk-bridge2.0-0",
      "libcups2",
      "libdrm2",
      "libgbm1",
      "libasound2"
    ],
    "variables": {
      "PUPPETEER_SKIP_DOWNLOAD": "true",
      "PUPPETEER_EXECUTABLE_PATH": "/usr/bin/chromium"
    }
  }
}
